--========================================================
-- AUTO COLLECT PACKS (FAST SCANNER)
--========================================================

local COLLECT_DELAY = 0.08

task.spawn(function()

	while true do
		if not autoCollectPacks then
			task.wait(0.2)
			continue
		end

		local plot = getPlayerPlot()
		if not plot then
			task.wait(0.5)
			continue
		end

		local packsFolder = plot:FindFirstChild("Packs")
		if not packsFolder then
			task.wait(0.2)
			continue
		end

		for _, packModel in ipairs(packsFolder:GetChildren()) do

			if not autoCollectPacks then
				break
			end

			if not packModel:IsA("Model") then
				continue
			end

			local packNameModel = nil

			-- find pack name model (not Top or Bottom)
			for _, child in ipairs(packModel:GetChildren()) do
				if child.Name ~= "Top" and child.Name ~= "Bottom" then
					packNameModel = child
					break
				end
			end

			if not packNameModel then
				continue
			end

			local timer =
				packNameModel:FindFirstChild("PackTimer")
				and packNameModel.PackTimer:FindFirstChild("Timer")

			if not timer then
				continue
			end

			if timer.Text == "Ready!" then

				local prompt = packModel:FindFirstChildWhichIsA("ProximityPrompt", true)

				if prompt then
					prompt.HoldDuration = 0
					fireproximityprompt(prompt)
				end

			end

		end

		task.wait(COLLECT_DELAY)

	end

end)

