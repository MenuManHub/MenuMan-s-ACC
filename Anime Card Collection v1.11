--========================================================
-- GOLD TOKEN FARM (STRICT REMOTE CONTROL)
--========================================================

local goldFarmEnabled = false

GameTab:CreateToggle({
	Name = "Gold Token Farm",
	CurrentValue = false,
	Flag = "GoldTokenFarmRemote",
	Callback = function(Value)
		goldFarmEnabled = Value
	end
})

--========================================================
-- REFERENCES
--========================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardRemote = ReplicatedStorage
	:WaitForChild("Remotes")
	:WaitForChild("Card")

local TOKEN_DELAY = 0.11

--========================================================
-- TOKEN COLLECT LOOP (STRICT CONDITIONS)
--========================================================

task.spawn(function()
	while true do
		-- Only run when enabled
		if not goldFarmEnabled then
			task.wait(0.2)
			continue
		end

		local tokenFolder =
			workspace:FindFirstChild("Items")
			and workspace.Items:FindFirstChild("Tokens")
			and workspace.Items.Tokens:FindFirstChild("Client")

		-- Only run if folder exists AND has children
		if not tokenFolder or #tokenFolder:GetChildren() == 0 then
			task.wait(0.2)
			continue
		end

		-- Process ONE token at a time
		local token = tokenFolder:GetChildren()[1]

		if token then
			local tokenId = token.Name

			pcall(function()
				CardRemote:FireServer("CollectToken", tokenId)
			end)

			-- STRICT delay between each fire
			task.wait(TOKEN_DELAY)
		end
	end
end)

--========================================================
-- AUTO COLLECT BOOSTS (TIMED REMOTES)
--========================================================

local autoBoostsEnabled = false

GameTab:CreateToggle({
	Name = "Auto Collect Boosts",
	CurrentValue = false,
	Flag = "AutoCollectBoosts",
	Callback = function(Value)
		autoBoostsEnabled = Value
	end
})

--========================================================
-- REFERENCES
--========================================================
local PotionRemote = game:GetService("ReplicatedStorage")
	:WaitForChild("Remotes")
	:WaitForChild("Potion")

-- Timings
local HATCH_LUCK_INTERVAL = (10 * 60) + 2   -- 10 minutes 2 seconds
local TRAVEL_INTERVAL     = (15 * 60) + 2   -- 15 minutes 2 seconds

--========================================================
-- FIRE FUNCTIONS
--========================================================
local function collectTravelTokens()
	pcall(function()
		PotionRemote:FireServer("Collect", "TravelToken1")
		PotionRemote:FireServer("Collect", "TravelToken2")
	end)
end

local function collectHatchAndLuck()
	pcall(function()
		PotionRemote:FireServer("Collect", "HatchTime")
		PotionRemote:FireServer("Collect", "Luck")
	end)
end

--========================================================
-- MAIN LOOP
--========================================================
task.spawn(function()

	local lastHatchLuck = 0
	local lastTravel = 0
	local initialized = false

	while task.wait(1) do
		if not autoBoostsEnabled then
			initialized = false
			continue
		end

		-- FIRST RUN: fire everything instantly
		if not initialized then
			collectTravelTokens()
			collectHatchAndLuck()

			lastHatchLuck = tick()
			lastTravel = tick()
			initialized = true
			continue
		end

		local now = tick()

		-- Hatch + Luck every 10m 2s
		if now - lastHatchLuck >= HATCH_LUCK_INTERVAL then
			collectHatchAndLuck()
			lastHatchLuck = now
		end

		-- Travel tokens every 15m 2s
		if now - lastTravel >= TRAVEL_INTERVAL then
			collectTravelTokens()
			lastTravel = now
		end
	end

end)

