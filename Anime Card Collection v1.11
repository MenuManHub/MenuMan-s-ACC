local autoPathEnabled = false

GameTab:CreateToggle({
	Name = "AutoFarm Moving",
	CurrentValue = false,
	Flag = "AutoPath",
	Callback = function(Value)
		autoPathEnabled = Value
	end
})

--========================================================
-- TWEEN PLAYER MOVEMENT
--========================================================
local function tweenToPosition(position)
	if not root then return end

	local distance = (root.Position - position).Magnitude
	local speed = 128
	local time = distance / speed

	local tween = TweenService:Create(
		root,
		TweenInfo.new(time, Enum.EasingStyle.Linear),
		{CFrame = CFrame.new(position)}
	)

	tween:Play()
	tween.Completed:Wait()
end

--========================================================
-- FIND READY PACK
--========================================================
local function getReadyPack(packsFolder)
	for _, packModel in ipairs(packsFolder:GetChildren()) do
		if packModel:IsA("Model") then
			local packNameModel
			for _, child in ipairs(packModel:GetChildren()) do
				if child.Name ~= "Top" and child.Name ~= "Bottom" then
					packNameModel = child
					break
				end
			end

			if packNameModel then
				local timer =
					packNameModel:FindFirstChild("PackTimer")
					and packNameModel.PackTimer:FindFirstChild("Timer")

				if timer and timer.Text == "Ready!" then
					return packModel
				end
			end
		end
	end

	return nil
end

--========================================================
-- NEW: GENERATE RANDOM POSITION AROUND PART (FOR ROAMING)
--========================================================
local function getRandomPositionAroundPart(part, minDist, maxDist)
	if not part then return nil end

	local angle = math.random() * math.pi * 2 -- random angle
	local distance = math.random() * (maxDist - minDist) + minDist
	local offset = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
	return part.Position + offset + Vector3.new(0,3,0) -- 3 studs above ground
end

--========================================================
-- AUTO PATH LOOP
--========================================================
task.spawn(function()
	local teleportedToSpawn = false

	while task.wait(0.2) do
		if not autoPathEnabled then
			teleportedToSpawn = false
			continue
		end

		local plot = getPlayerPlot()
		if not plot then continue end

		local spawnPart =
			plot:FindFirstChild("Misc")
			and plot.Misc:FindFirstChild("Spawn")

		local packsFolder = plot:FindFirstChild("Packs")

		if not spawnPart or not packsFolder then
			continue
		end

		-- TELEPORT TO SPAWN ONCE
		if not teleportedToSpawn then
			root.CFrame = spawnPart.CFrame + Vector3.new(0,3,0)
			teleportedToSpawn = true
			task.wait(1)
		end

		-- FIND READY PACK
		local readyPack = getReadyPack(packsFolder)

		if readyPack then
			local part = readyPack:FindFirstChild("Top", true) or readyPack:FindFirstChildWhichIsA("BasePart", true)
			if part then
				tweenToPosition(part.Position + Vector3.new(0,3,0))
				-- WAIT UNTIL PACK DISAPPEARS
				repeat
					task.wait(0.2)
				until not readyPack.Parent
			end

		-- NEW: ROAM AROUND PLACED PACKS WHEN NO READY PACKS
		else
			local allPackParts = {}
			for _, packModel in ipairs(packsFolder:GetChildren()) do
				if packModel:IsA("Model") then
					local part = packModel:FindFirstChild("Top", true) or packModel:FindFirstChildWhichIsA("BasePart", true)
					if part then
						table.insert(allPackParts, part)
					end
				end
			end

			if #allPackParts > 0 then
				local randomPackPart = allPackParts[math.random(#allPackParts)]
				local roamPos = getRandomPositionAroundPart(randomPackPart, 2.5, 12.5)
				tweenToPosition(roamPos)
				task.wait(0.5)
			end
			-- if no packs exist, player just waits
		end

	end
end)

