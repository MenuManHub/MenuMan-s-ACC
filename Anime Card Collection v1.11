local ReplicatedStorage = game:GetService("ReplicatedStorage")

local alertSound =
	ReplicatedStorage:WaitForChild("Assets")
	:WaitForChild("Sounds")
	:WaitForChild("Notifications")
	:WaitForChild("DragonBallAlert")

local TELEPORT_DELAY = 0.9

--========================================================
-- SAFE TELEPORT FUNCTION
--========================================================

local function teleportToPart(part)
	if not part or not root then return end
	root.CFrame = part.CFrame + Vector3.new(0, 3, 0)
end

--========================================================
-- MAIN TELEPORT SEQUENCE
--========================================================

local function teleportAllDragonBalls()

	-- Prevent overlapping runs
	if isTeleporting then return end
	isTeleporting = true

	local folder =
		workspace:FindFirstChild("Items")
		and workspace.Items:FindFirstChild("DragonBallSpawns")

	if not folder then
		isTeleporting = false
		return
	end

	-- Collect all valid parts
	local parts = {}

	for _, obj in ipairs(folder:GetChildren()) do
		if obj:IsA("BasePart") then
			table.insert(parts, obj)
		end
	end

	-- Sort by name (1 → 2 → 3 ...)
	table.sort(parts, function(a, b)
		return tonumber(a.Name) < tonumber(b.Name)
	end)

	-- Teleport through each
	for _, part in ipairs(parts) do
		if not dragonBallAutoTP then break end

		teleportToPart(part)
		task.wait(TELEPORT_DELAY)
	end

	isTeleporting = false
end

--========================================================
-- SOUND LISTENER
--========================================================

alertSound.Played:Connect(function()
	if not dragonBallAutoTP then return end

	-- Small delay ensures spawns exist
	task.wait(0.1)

	teleportAllDragonBalls()
end)

--========================================================
-- FALLBACK (IF .Played DOESN'T FIRE)
--========================================================

alertSound:GetPropertyChangedSignal("Playing"):Connect(function()
	if alertSound.Playing and dragonBallAutoTP then
		task.wait(0.1)
		teleportAllDragonBalls()
	end
end)
