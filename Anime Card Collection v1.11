do local Rayfield=loadstring(game:HttpGet("https://sirius.menu/rayfield"))();local Players=game:GetService("Players");local RunService=game:GetService("RunService");local HttpService=game:GetService("HttpService");local TeleportService=game:GetService("TeleportService");local player=Players.LocalPlayer;local character=player.Character or player.CharacterAdded:Wait() ;local humanoid=character:WaitForChild("Humanoid");local root=character:WaitForChild("HumanoidRootPart");local TweenService=game:GetService("TweenService");local Window=Rayfield:CreateWindow({Name="MenuMan's Anime Card Collection",LoadingTitle="MenuMan's Anime Card Collection",LoadingSubtitle="by DurDom",ShowText="DurDom",Theme="Serenity",ToggleUIKeybind=Enum.KeyCode.Insert,ConfigurationSaving={Enabled=true,FileName="DurDomHub"},KeySystem=false});local PlayerTab=Window:CreateTab("Player",4483362458);PlayerTab:CreateSection("Movement");local DEFAULT_WALKSPEED=25;local speedValue=25;local speedEnabled=false;local SpeedSlider=PlayerTab:CreateSlider({Name="Speed",Range={1,150},Increment=1,Suffix="Speed",CurrentValue=speedValue,Flag="SpeedSlider",Callback=function(Value) speedValue=Value;end});local SpeedToggle=PlayerTab:CreateToggle({Name="Enable Speed",CurrentValue=false,Flag="SpeedToggle",Callback=function(Value) speedEnabled=Value;if humanoid then humanoid.WalkSpeed=(speedEnabled and speedValue) or DEFAULT_WALKSPEED ;end end});RunService.RenderStepped:Connect(function() if  not speedEnabled then return;end if ( not humanoid or  not root) then return;end humanoid.WalkSpeed=speedValue;local moveDir=humanoid.MoveDirection;if (moveDir.Magnitude>0) then root.AssemblyLinearVelocity=Vector3.new(moveDir.X * speedValue ,root.AssemblyLinearVelocity.Y,moveDir.Z * speedValue );end end);player.CharacterAdded:Connect(function(char) character=char;humanoid=char:WaitForChild("Humanoid");root=char:WaitForChild("HumanoidRootPart");humanoid.WalkSpeed=DEFAULT_WALKSPEED;end);local antiAfkEnabled=false;PlayerTab:CreateToggle({Name="Anti AFK",CurrentValue=false,Flag="AntiAFK",Callback=function(Value) antiAfkEnabled=Value;end});local Players=game:GetService("Players");local VirtualUser=game:GetService("VirtualUser");local RunService=game:GetService("RunService");local player=Players.LocalPlayer;player.Idled:Connect(function() if  not antiAfkEnabled then return;end VirtualUser:CaptureController();VirtualUser:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame);task.wait(0.5);VirtualUser:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame);end);task.spawn(function() while task.wait(60) do if  not antiAfkEnabled then continue;end RunService.RenderStepped:Wait();end end);local function getPlayerPlot() local plotsFolder=workspace:FindFirstChild("Plots");if  not plotsFolder then warn("[AutoPlace] Plots folder not found");return nil;end local usernameLower=string.lower(player.Name);local displayNameLower=string.lower(player.DisplayName);for _,plot in ipairs(plotsFolder:GetChildren()) do if ( not plot:IsA("Model") and  not plot:IsA("Folder")) then continue;end local display=plot:FindFirstChild("Map") and plot.Map:FindFirstChild("Display") and plot.Map.Display:FindFirstChild("Top") and plot.Map.Display.Top:FindFirstChild("Gui") and plot.Map.Display.Top.Gui:FindFirstChild("Display") and plot.Map.Display.Top.Gui.Display:FindFirstChild("Display") ;if (display and (typeof(display.Text)=="string")) then local textLower=string.lower(display.Text);if (string.find(textLower,usernameLower,1,true) or string.find(textLower,displayNameLower,1,true)) then return plot;end end end warn("[AutoPlace] No plot found for player:",player.Name);return nil;end local GameTab=Window:CreateTab("Game",4483362458);GameTab:CreateSection("Auto Collection");local goldFarmEnabled=false;GameTab:CreateToggle({Name="Gold Token Farm",CurrentValue=false,Flag="GoldTokenFarmRemote",Callback=function(Value) goldFarmEnabled=Value;end});local ReplicatedStorage=game:GetService("ReplicatedStorage");local CardRemote=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Card");local TOKEN_DELAY=0.11;task.spawn(function() while true do if  not goldFarmEnabled then task.wait(0.2);continue;end local tokenFolder=workspace:FindFirstChild("Items") and workspace.Items:FindFirstChild("Tokens") and workspace.Items.Tokens:FindFirstChild("Client") ;if ( not tokenFolder or ( #tokenFolder:GetChildren()==0)) then task.wait(0.2);continue;end local token=tokenFolder:GetChildren()[1];if token then local tokenId=token.Name;pcall(function() CardRemote:FireServer("CollectToken",tokenId);end);task.wait(TOKEN_DELAY);end end end);local autoBoostsEnabled=false;GameTab:CreateToggle({Name="Auto Collect Boosts",CurrentValue=false,Flag="AutoCollectBoostsRemote",Callback=function(Value) autoBoostsEnabled=Value;end});local ReplicatedStorage=game:GetService("ReplicatedStorage");local PotionRemote=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Potion");local BOOST_DELAY=0.11;local boostData={{Path={"Items","Misc","Collectables","TravelToken1"},Remote="TravelToken1"},{Path={"Items","Misc","Collectables","TravelToken2"},Remote="TravelToken2"},{Path={"Items","Misc","Collectables","HatchTime","Part"},Remote="HatchTime"},{Path={"Items","Misc","Collectables","Luck","Part"},Remote="Luck"}};local function getObjectFromPath(path) local obj=workspace;for _,name in ipairs(path) do obj=obj:FindFirstChild(name);if  not obj then return nil;end end return obj;end task.spawn(function() while true do if  not autoBoostsEnabled then task.wait(0.2);continue;end for _,data in ipairs(boostData) do if  not autoBoostsEnabled then break;end local obj=getObjectFromPath(data.Path);if (obj and obj:IsA("BasePart") and (obj.Transparency<1)) then pcall(function() PotionRemote:FireServer("Collect",data.Remote);end);task.wait(BOOST_DELAY);end end task.wait(0.2);end end);local autoCollectEggs=false;GameTab:CreateToggle({Name="Auto Collect Eggs",CurrentValue=false,Flag="AutoCollectEggs",Callback=function(Value) autoCollectEggs=Value;end});local EasterRemote=game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Easter");local EGG_DELAY=0.1;local MAX_EGGS=70;task.spawn(function() while true do if  not autoCollectEggs then task.wait(0.2);continue;end local eggFolder=workspace:FindFirstChild("Items") and workspace.Items:FindFirstChild("EasterEggSpawns") ;if  not eggFolder then task.wait(0.5);continue;end for i=1,MAX_EGGS do if  not autoCollectEggs then break;end local eggName=tostring(i);local eggPart=eggFolder:FindFirstChild(eggName);if eggPart then pcall(function() EasterRemote:FireServer("Collect",eggName);end);task.wait(EGG_DELAY);end end end end);local conveyorDragonBallEnabled=false;GameTab:CreateToggle({Name="Conveyor Dragon Ball",CurrentValue=false,Flag="ConveyorDragonBall",Callback=function(v) conveyorDragonBallEnabled=v;end});local dragonBallAutoTP=false;local isTeleporting=false;GameTab:CreateToggle({Name="Auto Dragon Ball Collect",CurrentValue=false,Flag="DragonBallAutoTP",Callback=function(Value) dragonBallAutoTP=Value;end});local ReplicatedStorage=game:GetService("ReplicatedStorage");local alertSound=ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Notifications"):WaitForChild("DragonBallAlert");local TELEPORT_DELAY=0.9;local function teleportToPart(part) if ( not part or  not root) then return;end root.CFrame=part.CFrame + Vector3.new(0,3,0) ;end local function teleportAllDragonBalls() if isTeleporting then return;end isTeleporting=true;local folder=workspace:FindFirstChild("Items") and workspace.Items:FindFirstChild("DragonBallSpawns") ;if  not folder then isTeleporting=false;return;end local parts={};for _,obj in ipairs(folder:GetChildren()) do if obj:IsA("BasePart") then table.insert(parts,obj);end end table.sort(parts,function(a,b) return tonumber(a.Name)<tonumber(b.Name) ;end);for _,part in ipairs(parts) do if  not dragonBallAutoTP then break;end teleportToPart(part);task.wait(TELEPORT_DELAY);end isTeleporting=false;end alertSound.Played:Connect(function() if  not dragonBallAutoTP then return;end task.wait(0.1);teleportAllDragonBalls();end);alertSound:GetPropertyChangedSignal("Playing"):Connect(function() if (alertSound.Playing and dragonBallAutoTP) then task.wait(0.1);teleportAllDragonBalls();end end);GameTab:CreateSection("Collect Cash");local Players=game:GetService("Players");local ReplicatedStorage=game:GetService("ReplicatedStorage");local LocalPlayer=Players.LocalPlayer;local CardRemote=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Card");local autoCollectEnabled=false;local function getPlayerPlot() local plotsFolder=workspace:FindFirstChild("Plots");if  not plotsFolder then warn("[PlotDetect] workspace.Plots not found");return nil;end local displayName=string.lower(LocalPlayer.DisplayName);for i=1,6 do local plot=plotsFolder:FindFirstChild(tostring(i));if plot then local display=plot:FindFirstChild("Map") and plot.Map:FindFirstChild("Display") and plot.Map.Display:FindFirstChild("Top") and plot.Map.Display.Top:FindFirstChild("Gui") and plot.Map.Display.Top.Gui:FindFirstChild("Display") and plot.Map.Display.Top.Gui.Display:FindFirstChild("Display") ;if (display and (typeof(display.Text)=="string")) then local text=string.lower(display.Text);if string.find(text,displayName,1,true) then print("[PlotDetect] Found player plot:",i);return plot;end end end end warn("[PlotDetect] No plot found for player:",LocalPlayer.DisplayName);return nil;end local function collectSide(sideModel) if  not sideModel then return;end for i=1,9 do if  not autoCollectEnabled then return;end local part=sideModel:FindFirstChild(tostring(i));if (part and part:IsA("BasePart")) then CardRemote:FireServer("Collect",part);task.wait(0.05);end end end local function collectCurrentPage(plot) if  not plot then return;end local map=plot:FindFirstChild("Map");if  not map then return;end local display=map:FindFirstChild("Display");if  not display then return;end local leftModel=display:FindFirstChild("Left");local rightModel=display:FindFirstChild("Right");collectSide(leftModel);collectSide(rightModel);end local function pageRight() CardRemote:FireServer("Page","RightArrow");end local function pageLeft() CardRemote:FireServer("Page","LeftArrow");end task.spawn(function() while task.wait(0.25) do if  not autoCollectEnabled then continue;end local plot=getPlayerPlot();if  not plot then task.wait(1);continue;end for i=1,9 do if  not autoCollectEnabled then break;end collectCurrentPage(plot);task.wait(0.1);pageRight();task.wait(0.15);end for i=1,8 do if  not autoCollectEnabled then break;end collectCurrentPage(plot);task.wait(0.1);pageLeft();task.wait(0.15);end end end);GameTab:CreateToggle({Name="Auto Collect Cash",CurrentValue=false,Flag="AutoCollectCash",Callback=function(Value) autoCollectEnabled=Value;end});local merchantTPEnabled=false;GameTab:CreateToggle({Name="Auto Traveling Merchant",CurrentValue=false,Flag="MerchantTP",Callback=function(Value) merchantTPEnabled=Value;end});task.spawn(function() while task.wait(1) do if  not merchantTPEnabled then continue;end if  not root then continue;end local merchant=workspace:FindFirstChild("Items") and workspace.Items:FindFirstChild("Merchant") and workspace.Items.Merchant:FindFirstChild("Client") and workspace.Items.Merchant.Client:FindFirstChild("MerchantStand") ;if (merchant and merchant:IsA("Model")) then local part=merchant:FindFirstChildWhichIsA("BasePart");if part then root.CFrame=part.CFrame + Vector3.new(0,2,0) ;end end end end);GameTab:CreateSection("AutoFarm Cards");local autoCollectPacks=false;GameTab:CreateToggle({Name="Auto Collect Packs",CurrentValue=false,Flag="AutoCollectPacks",Callback=function(Value) autoCollectPacks=Value;end});local COLLECT_DELAY=0.08;task.spawn(function() while true do if  not autoCollectPacks then task.wait(0.2);continue;end local plot=getPlayerPlot();if  not plot then task.wait(0.5);continue;end local packsFolder=plot:FindFirstChild("Packs");if  not packsFolder then task.wait(0.2);continue;end for _,packModel in ipairs(packsFolder:GetChildren()) do if  not autoCollectPacks then break;end if  not packModel:IsA("Model") then continue;end local packNameModel=nil;for _,child in ipairs(packModel:GetChildren()) do if ((child.Name~="Top") and (child.Name~="Bottom")) then packNameModel=child;break;end end if  not packNameModel then continue;end local timer=packNameModel:FindFirstChild("PackTimer") and packNameModel.PackTimer:FindFirstChild("Timer") ;if  not timer then continue;end if (timer.Text=="Ready!") then local prompt=packModel:FindFirstChildWhichIsA("ProximityPrompt",true);if prompt then prompt.HoldDuration=0;fireproximityprompt(prompt);end end end task.wait(COLLECT_DELAY);end end);local autoPlacePacks=false;GameTab:CreateToggle({Name="Auto Place Packs",CurrentValue=false,Flag="AutoPlacePacks",Callback=function(Value) autoPlacePacks=Value;end});local function getPackInHand() local playersFolder=workspace:FindFirstChild("Players");if  not playersFolder then return nil;end local playerModel=playersFolder:FindFirstChild(player.Name);if  not playerModel then return nil;end local hrp=playerModel:FindFirstChild("HumanoidRootPart");if  not hrp then return nil;end for _,child in ipairs(hrp:GetChildren()) do if child:IsA("Model") then return child.Name;end end return nil;end local PLACE_DELAY=0.03;task.spawn(function() while true do if autoPlacePacks then local packName=getPackInHand();if packName then local args={"Place",packName};pcall(function() game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Card"):FireServer(unpack(args));end);end end task.wait(PLACE_DELAY);end end);local autoPathEnabled=false;GameTab:CreateToggle({Name="AutoFarm Moving",CurrentValue=false,Flag="AutoPath",Callback=function(Value) autoPathEnabled=Value;end});local function tweenToPosition(position) if  not root then return;end local distance=(root.Position-position).Magnitude;local speed=128;local time=distance/speed ;local tween=TweenService:Create(root,TweenInfo.new(time,Enum.EasingStyle.Linear),{CFrame=CFrame.new(position)});tween:Play();tween.Completed:Wait();end local function getReadyPack(packsFolder) for _,packModel in ipairs(packsFolder:GetChildren()) do if packModel:IsA("Model") then local packNameModel;for _,child in ipairs(packModel:GetChildren()) do if ((child.Name~="Top") and (child.Name~="Bottom")) then packNameModel=child;break;end end if packNameModel then local timer=packNameModel:FindFirstChild("PackTimer") and packNameModel.PackTimer:FindFirstChild("Timer") ;if (timer and (timer.Text=="Ready!")) then return packModel;end end end end return nil;end local function getRandomPositionAroundPart(part,minDist,maxDist) if  not part then return nil;end local angle=math.random() * math.pi * 2 ;local distance=(math.random() * (maxDist-minDist)) + minDist ;local offset=Vector3.new(math.cos(angle) * distance ,0,math.sin(angle) * distance );return part.Position + offset + Vector3.new(0,3,0) ;end task.spawn(function() local teleportedToSpawn=false;while task.wait(0.2) do if  not autoPathEnabled then teleportedToSpawn=false;continue;end local plot=getPlayerPlot();if  not plot then continue;end local spawnPart=plot:FindFirstChild("Misc") and plot.Misc:FindFirstChild("Spawn") ;local packsFolder=plot:FindFirstChild("Packs");if ( not spawnPart or  not packsFolder) then continue;end if  not teleportedToSpawn then root.CFrame=spawnPart.CFrame + Vector3.new(0,3,0) ;teleportedToSpawn=true;task.wait(1);end local readyPack=getReadyPack(packsFolder);if readyPack then local part=readyPack:FindFirstChild("Top",true) or readyPack:FindFirstChildWhichIsA("BasePart",true) ;if part then tweenToPosition(part.Position + Vector3.new(0,3,0) );repeat task.wait(0.2);until  not readyPack.Parent end else local allPackParts={};for _,packModel in ipairs(packsFolder:GetChildren()) do if packModel:IsA("Model") then local part=packModel:FindFirstChild("Top",true) or packModel:FindFirstChildWhichIsA("BasePart",true) ;if part then table.insert(allPackParts,part);end end end if ( #allPackParts>0) then local randomPackPart=allPackParts[math.random( #allPackParts)];local roamPos=getRandomPositionAroundPart(randomPackPart,2.5,12.5);tweenToPosition(roamPos);task.wait(0.5);end end end end);local AutoFarmTab=Window:CreateTab("Auto Farming",4483362458);AutoFarmTab:CreateSection("Pack Automation");local MutationTab=Window:CreateTab("Mutation Filters",4483362458);MutationTab:CreateSection("Allowed Mutations");local ReplicatedStorage=game:GetService("ReplicatedStorage");local Players=game:GetService("Players");local player=Players.LocalPlayer;local CardRemote=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Card");local autoFarmPacksEnabled=false;local selectedPacks={};local mutationFilters={Gold=false,Emerald=false,Void=false,Diamond=false,Rainbow=false};for mutation,_ in pairs(mutationFilters) do MutationTab:CreateToggle({Name=mutation,CurrentValue=false,Flag="Mutation_"   .. mutation ,Callback=function(v) mutationFilters[mutation]=v;print("[MutationTab] "   .. mutation   .. " set to" ,v);end});end task.delay(1,function() for mutation,_ in pairs(mutationFilters) do local flag=Rayfield.Flags["Mutation_"   .. mutation ];if (flag and (flag.CurrentValue~=nil)) then mutationFilters[mutation]=flag.CurrentValue;print("[MutationTab] Restored",mutation,flag.CurrentValue);end end end);AutoFarmTab:CreateToggle({Name="Auto Farm Packs",CurrentValue=false,Flag="AutoFarmPacks",Callback=function(v) autoFarmPacksEnabled=v;print("[AutoFarm] Auto Farm Packs toggled:",v);end});local packsFolder=ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("Packs") ;if packsFolder then for _,pack in ipairs(packsFolder:GetChildren()) do if pack:IsA("Model") then selectedPacks[pack.Name]=true;AutoFarmTab:CreateToggle({Name=pack.Name,CurrentValue=false,Flag="Pack_"   .. pack.Name ,Callback=function(v) selectedPacks[pack.Name]=v;print("[AutoFarm] Pack "   .. pack.Name   .. " set to" ,v);end});end end end task.delay(1,function() for packName,_ in pairs(selectedPacks) do local flag=Rayfield.Flags["Pack_"   .. packName ];if (flag and (flag.CurrentValue~=nil)) then selectedPacks[packName]=flag.CurrentValue;print("[AutoFarm] Restored pack:",packName,flag.CurrentValue);end end end);local function mutationPasses(packInstance) local anyEnabled=false;for _,enabled in pairs(mutationFilters) do if enabled then anyEnabled=true;break;end end if  not anyEnabled then print("[Mutation] No filters enabled → allow all mutations for pack:",packInstance.Name);return true;end for _,descendant in ipairs(packInstance:GetDescendants()) do if (descendant:IsA("Model") or descendant:IsA("Folder") or descendant:IsA("Part")) then local name=descendant.Name:gsub("%s+",""):lower();for filterName,enabled in pairs(mutationFilters) do if (enabled and (name==filterName:lower())) then print("[Mutation] Allowed mutation found:",descendant.Name,"in pack:",packInstance.Name);return true;end end end end print("[Mutation] No allowed mutations in pack:",packInstance.Name);return false;end local function getPlayerPlot() local plotsFolder=workspace:FindFirstChild("Plots");if  not plotsFolder then warn("[PlotDetect] workspace.Plots not found");return nil;end local displayName=string.lower(game.Players.LocalPlayer.DisplayName);for i=1,6 do local plot=plotsFolder:FindFirstChild(tostring(i));if plot then local display=plot:FindFirstChild("Map") and plot.Map:FindFirstChild("Display") and plot.Map.Display:FindFirstChild("Top") and plot.Map.Display.Top:FindFirstChild("Gui") and plot.Map.Display.Top.Gui:FindFirstChild("Display") and plot.Map.Display.Top.Gui.Display:FindFirstChild("Display") ;if (display and (typeof(display.Text)=="string")) then local text=string.lower(display.Text);if string.find(text,displayName,1,true) then print("[PlotDetect] Found player plot:",i,"Text:",display.Text);return plot,i;end end end end warn("[PlotDetect] No plot found for player:",game.Players.LocalPlayer.DisplayName);return nil;end task.spawn(function() 