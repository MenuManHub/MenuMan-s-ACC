--========================================================
-- GET PACK IN HAND
--========================================================
local function getPackInHand()

	local playersFolder = workspace:FindFirstChild("Players")
	if not playersFolder then
		return nil
	end

	local playerModel = playersFolder:FindFirstChild(player.Name)
	if not playerModel then
		return nil
	end

	local hrp = playerModel:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end

	for _, child in ipairs(hrp:GetChildren()) do
		if child:IsA("Model") then
			return child.Name
		end
	end

	return nil
end

--========================================================
-- AUTO PLACE PACK LOOP (FAST)
--========================================================
local PLACE_DELAY = 0.03

task.spawn(function()

	while true do
		if autoPlacePacks then

			local packName = getPackInHand()

			if packName then

				local args = {
					"Place",
					packName
				}

				pcall(function()
					game:GetService("ReplicatedStorage")
						:WaitForChild("Remotes")
						:WaitForChild("Card")
						:FireServer(unpack(args))
				end)

			end

		end

		task.wait(PLACE_DELAY)

	end
end)


